.game-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.game-menu--hidden {
    display: none;
}

.game-menu__panel {
    min-width: 420px;
    padding: 32px;
    border-radius: 16px;
    background-color: rgb(32, 34, 40);
}

.game-menu__title {
    margin-bottom: 24px;
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.game-menu__section {
    margin-bottom: 12px;
    font-size: 22px;
    color: rgb(170, 175, 185);
}

.game-menu__character {
    height: 56px;
    margin: 0 0 10px 0;
    border-width: 2px;
    border-radius: 10px;
    border-color: rgb(70, 74, 84);
    background-color: rgb(50, 53, 61);
    font-size: 24px;
    color: rgb(235, 235, 240);
}

.game-menu__character:hover {
    background-color: rgb(64, 68, 78);
}

.game-menu__character--selected {
    border-color: rgb(255, 196, 64);
    background-color: rgb(86, 72, 40);
}

.game-menu__hint {
    margin-top: 14px;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(140, 145, 155);
}
