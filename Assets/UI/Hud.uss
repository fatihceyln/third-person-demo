.hud {
    position: absolute;
    right: 32px;
    bottom: 32px;
    flex-direction: row;
    padding: 16px 22px 14px 18px;
    border-radius: 14px;
    background-color: rgba(14, 16, 22, 0.62);
}

/* Key and label share the same leading edge instead of being centered on each other. */
.hud__item {
    align-items: flex-start;
    margin-right: 28px;
}

.hud__item--last {
    margin-right: 0;
}

.hud__key {
    min-width: 44px;
    height: 40px;
    padding: 0 12px;
    border-width: 0 0 4px 0;
    border-radius: 8px;
    border-color: rgb(160, 165, 178);
    background-color: rgb(246, 246, 249);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(28, 30, 38);
}

.hud__label {
    margin-top: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(255, 255, 255);
}
